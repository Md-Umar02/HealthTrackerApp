@page
@model HealthTracker.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="~/css/auth.css" rel="stylesheet" />

<style>
    .auth-page .container {
        max-width: 450px;
        margin: 0 auto;
    }
</style>

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="auth-card card p-4">
                    <div class="text-center mb-3">
                        <div class="auth-icon-wrapper">
                            <i class="bi bi-box-arrow-in-right text-white" style="font-size: 1.5rem;"></i>
                        </div>
                        <h1 class="auth-title">Welcome Back</h1>
                        <p class="auth-subtitle">Sign in to your HealthTracker account</p>
                    </div>

                    <form method="post" autocomplete="off">
                        <div class="mb-3">
                            <label for="Email" class="form-label">
                                <i class="bi bi-envelope-fill me-1"></i>Email Address
                            </label>
                            <input asp-for="Email" type="email" class="form-control auth-input"
                                   placeholder="name@example.com"
                                   autocomplete="email"
                                   required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label for="Password" class="form-label">
                                <i class="bi bi-lock-fill me-1"></i>Password
                            </label>
                            <input asp-for="Password" type="password"
                                   class="form-control auth-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text text-end">
                                <a href="#" class="text-decoration-none small">
                                    <i class="bi bi-question-circle me-1"></i>Forgot password?
                                </a>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn auth-btn-primary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger auth-alert" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @Model.ErrorMessage
                            </div>
                        }
                    </form>

                    <div class="text-center mt-3 pt-3 border-top">
                        <p class="text-muted mb-2 small">Don't have an account?</p>
                        <a href="/Auth/Register" class="btn auth-btn-outline btn-sm">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <a href="/" class="text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>