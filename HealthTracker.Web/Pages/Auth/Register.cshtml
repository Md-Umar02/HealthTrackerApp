@page
@model HealthTracker.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="~/css/auth.css" rel="stylesheet" />

<style>
    /* Ensure form is properly sized */
    .auth-page .container {
        max-width: 450px;
        margin: 0 auto;
    }
</style>

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="auth-card card p-4">
                    <div class="text-center mb-3">
                        <div class="auth-icon-wrapper">
                            <i class="bi bi-person-plus text-white" style="font-size: 1.5rem;"></i>
                        </div>
                        <h1 class="auth-title">Create Account</h1>
                        <p class="auth-subtitle">Join HealthTracker today</p>
                    </div>

                    <form method="post" autocomplete="off">
                        <div class="mb-3">
                            <label for="Name" class="form-label">
                                <i class="bi bi-person-fill me-1"></i>Full Name
                            </label>
                            <input asp-for="Name" class="form-control auth-input"
                                   placeholder="Enter your full name"
                                   autocomplete="name"
                                   required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label for="Email" class="form-label">
                                <i class="bi bi-envelope-fill me-1"></i>Email Address
                            </label>
                            <input asp-for="Email" type="email" class="form-control auth-input"
                                   placeholder="name@example.com"
                                   autocomplete="email"
                                   required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label for="Age" class="form-label">
                                <i class="bi bi-calendar3 me-1"></i>Age
                            </label>
                            <input asp-for="Age" type="number" class="form-control auth-input"
                                   placeholder="Enter your age"
                                   min="1" max="120"
                                   autocomplete="off"
                                   required />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label for="Password" class="form-label">
                                <i class="bi bi-lock-fill me-1"></i>Password
                            </label>
                            <input asp-for="Password" type="password"
                                   class="form-control auth-input"
                                   placeholder="Create a strong password"
                                   autocomplete="new-password"
                                   required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Use 8+ characters with letters, numbers & symbols
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn auth-btn-primary">
                                <i class="bi bi-check-circle-fill me-2"></i>Create Account
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger auth-alert" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @Model.ErrorMessage
                            </div>
                        }
                    </form>

                    <div class="text-center mt-3 pt-3 border-top">
                        <p class="text-muted mb-2 small">Already have an account?</p>
                        <a href="/Auth/Login" class="btn auth-btn-outline btn-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <a href="/" class="text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>