@page
@model HealthTracker.Web.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "My Profile";
}

<!-- CSS Files -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="~/css/profile.css" rel="stylesheet" />

<div class="profile-container">
    @if (Model.User != null)
    {
        <div class="profile-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    <i class="bi bi-person-circle"></i>
                </div>
                <h2>@Model.User.Name</h2>
            </div>
            
            <div class="profile-body">
                <!-- Personal Information -->
                <div class="info-section">
                    <h3>
                        <i class="bi bi-person-badge"></i>
                        Personal Information
                    </h3>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">
                                <i class="bi bi-envelope"></i> Email Address
                            </div>
                            <div class="info-value">@Model.User.Email</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">
                                <i class="bi bi-calendar3"></i> Age
                            </div>
                            <div class="info-value">@Model.User.Age years</div>
                        </div>
                    </div>
                </div>

                <!-- Health Metrics -->
                <div class="info-section">
                    <h3>
                        <i class="bi bi-heart-pulse"></i>
                        Recent Health Metrics
                    </h3>
                    
                    @if (Model.User.HealthMetrics != null && Model.User.HealthMetrics.Any())
                    {
                        <div class="table-responsive">
                            <table class="metrics-table">
                                <thead>
                                    <tr>
                                        <th><i class="bi bi-bar-chart-line me-1"></i> Metric</th>
                                        <th><i class="bi bi-123 me-1"></i> Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var metric in Model.User.HealthMetrics.Take(5))
                                    {
                                        <tr>
                                            <td>@metric.MetricType</td>
                                            <td><strong>@metric.Value</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        @if (Model.User.HealthMetrics.Count() > 5)
                        {
                            <div class="text-muted mt-2 small">
                                <i class="bi bi-info-circle"></i>
                                Showing last 5 metrics. <a href="/HealthMetrics/Index">View all @Model.User.HealthMetrics.Count() metrics</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-clipboard-heart"></i>
                            <p>No health metrics recorded yet.</p>
                            <a href="/HealthMetrics/Create" class="btn-primary" style="display: inline-flex;">
                                <i class="bi bi-plus-circle"></i> Add Your First Metric
                            </a>
                        </div>
                    }
                </div>

                <!-- AI Insights Section -->
                <div class="info-section">
                    <h3>
                        <i class="bi bi-robot"></i>
                        AI Health Insights
                    </h3>
                    
                    <div class="insights-form">
                        @if (Model.User.HealthMetrics != null && Model.User.HealthMetrics.Any())
                        {
                            <form id="insightsForm" method="post" asp-page-handler="GetInsights" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" id="getInsightsBtn" class="btn-insights">
                                    <i class="bi bi-stars"></i> Get AI Insights
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn-insights" disabled style="opacity: 0.5; cursor: not-allowed;">
                                <i class="bi bi-stars"></i> Add Health Metrics First
                            </button>
                            <div class="form-text mt-2">
                                <i class="bi bi-info-circle"></i> You need to add health metrics before getting AI insights
                            </div>
                        }
                    </div>

                    <!-- AI Response Container -->
                    <div id="aiInsightsContainer" style="display: none;">
                        <div class="insights-card">
                            <div class="insights-header">
                                <i class="bi bi-lightbulb"></i>
                                <h4>Your AI-Powered Insights</h4>
                                <small>Generated just for you</small>
                            </div>
                            <div class="insights-content" id="aiResponseContent">
                                <!-- Formatted insights will appear here -->
                            </div>
                            <div class="insights-footer">
                                <i class="bi bi-shield-check"></i>
                                Powered by Google Gemini
                            </div>
                        </div>
                    </div>

                    <!-- Loading Spinner -->
                    <div id="loadingSpinner" style="display: none; text-align: center; padding: 20px;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Analyzing your health data...</p>
                    </div>

                    <!-- Error Message Container -->
                    <div id="errorMessage" class="alert alert-danger" style="display: none; margin-top: 15px;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="errorText"></span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <a href="/HealthMetrics/Create" class="btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Health Metric
                    </a>
                    <a href="/HealthMetrics/Index" class="btn-secondary">
                        <i class="bi bi-table"></i> View All Metrics
                    </a>
                    <a href="/Auth/Logout" class="btn-danger"
                           onclick="return confirm('Are you sure you want to logout?');">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="profile-card">
            <div class="profile-body" style="text-align: center; padding: 50px;">
                <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
                <h3>User Not Found</h3>
                <p>Unable to load your profile information.</p>
                <a href="/" class="btn-primary" style="display: inline-flex; margin-top: 20px;">
                    <i class="bi bi-house"></i> Back to Home
                </a>
            </div>
        </div>
    }
</div>

<!-- JavaScript Files -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/profile.js"></script>

<script>
    // Intercept form submission to use AJAX
    document.addEventListener('DOMContentLoaded', function() {
    const insightsForm = document.getElementById('insightsForm');
        
    if (insightsForm) {
    insightsForm.addEventListener('submit', async function(e) {
    e.preventDefault(); // Prevent normal form submission
                
    const form = this;
    const submitBtn = document.getElementById('getInsightsBtn');
    const container = document.getElementById('aiInsightsContainer');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const errorMessage = document.getElementById('errorMessage');
    const responseContent = document.getElementById('aiResponseContent');
                
    // Disable button and show loading
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="bi bi-stars"></i> Generating insights...';
                
    // Hide previous results and error
    container.style.display = 'none';
    errorMessage.style.display = 'none';
    loadingSpinner.style.display = 'block';
                
    try {
    // Get form data
    const formData = new FormData(form);
                    
    // Make AJAX POST request
    const response = await fetch(form.action, {
    method: 'POST',
    body: formData,
    headers: {
    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
    }
    });
                    
    if (response.ok) {
    const result = await response.json();
                        
    if (result.insights) {
    // Display formatted insights
    responseContent.innerHTML = result.insights;
    container.style.display = 'block';
    } else if (result.error) {
    errorMessage.style.display = 'block';
    document.getElementById('errorText').textContent = result.error;
    } else {
    errorMessage.style.display = 'block';
    document.getElementById('errorText').textContent = 'Unable to get insights.';
    }
    } else {
    errorMessage.style.display = 'block';
    document.getElementById('errorText').textContent = 'Failed to get insights. Status: ' + response.status;
    }
    } catch (error) {
    console.error('Error:', error);
    errorMessage.style.display = 'block';
    document.getElementById('errorText').textContent = 'Network error. Please check your connection and try again.';
    } finally {
    // Hide loading, enable button
    loadingSpinner.style.display = 'none';
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="bi bi-stars"></i> Get AI Insights';
    }
    });
    }
    });
</script>