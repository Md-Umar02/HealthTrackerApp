@page
@model HealthTracker.Web.Pages.HealthMetrics.IndexModel

<h2>My Health Metrics</h2>

@if(TempData["SuccessMessage"] != null)
{
    <script>    
        alert("@TempData["SuccessMessage"]");
    </script>
}

<a asp-page="/HealthMetrics/Create">➕ Add Health Metric</a>

<br /><br />

@if (Model.Metrics.Any())
{
    <table border="1" cellpadding="5">
        <tr>
            <th>Date</th>
            <th>Metric</th>
            <th>Value</th>
            <th>Action</th>
        </tr>
        @foreach (var item in Model.Metrics)
        {
            <tr>
                <td>@item.RecordedAt.ToShortDateString()</td>
                <td>@item.MetricType</td>
                <td>@item.Value</td>

                <td>
                    <form method="post"
                        asp-page-handler="Delete">
                        <input type="hidden" name="id"
                            value="@item.Id"/>
                            <button type="submit"
                                onclick="return confirm('Are you sure you want to delete this record?');">
                                🗑️ Delete
                            </button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
else
{
    <p>No health records found.</p>
}