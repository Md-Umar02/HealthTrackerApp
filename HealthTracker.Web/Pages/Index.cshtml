@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="~/css/index.css" rel="stylesheet" />

<div class="index-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card index-card p-5">
                    <div class="index-icon-wrapper">
                        <i class="bi bi-heart-pulse text-white" style="font-size: 2rem;"></i>
                    </div>

                    <h1 class="index-title">HealthTracker</h1>
                    <p class="index-subtitle">Track your wellness journey</p>

                    <div class="d-grid gap-3">
                        <a class="btn index-btn-primary" href="/Auth/Register">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </a>

                        <a class="btn index-btn-outline" href="/Auth/Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top text-muted small">
                        <i class="bi bi-shield-check me-1"></i>
                        Your data is secure & private
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>